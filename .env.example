# ==============================================================================
# SAIL YANTRA — TinyFish Market Intelligence & ML Pipeline Configuration
# ==============================================================================

# TinyFish Official API Key
# Sign up at https://tinyfish.ai to obtain your API key.
# Leave blank to run with local cached/seeded baseline data in test mode.
TINYFISH_API_KEY=

# TinyFish Agent Automation Endpoint
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# Official Public Source URLs for Web Agent Ingestion
BDI_SOURCE_URL=https://tradingeconomics.com/commodity/baltic
BUNKER_SOURCE_URL=https://shipandbunker.com/prices

# HTTP Client Timeouts & Retries
TINYFISH_REQUEST_TIMEOUT_SECONDS=60.0
TINYFISH_CONNECT_TIMEOUT_SECONDS=10.0
TINYFISH_MAX_RETRIES=3
TINYFISH_RETRY_BACKOFF_FACTOR=1.5

# Persistence & Freshness TTL (in seconds)
# Default: 14400 (4 hours)
MARKET_CACHE_TTL_SECONDS=14400

# Manual Synchronization Security & Debounce
# Optional secret token required in 'X-Sync-Token' or 'Authorization: Bearer <token>' header.
# If left empty, manual sync is permitted in local development mode.
SYNC_SECRET_TOKEN=
SYNC_MIN_INTERVAL_SECONDS=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501,*
